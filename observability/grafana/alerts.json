{
  "title": "Daily Machine Spirit",
  "interval": 300,
  "rules": [
    {
      "uid": "dms-refills-failing",
      "title": "Refills failing",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 3600, "to": 0 },
          "datasourceUid": "${prometheus}",
          "model": {
            "refId": "A",
            "instant": true,
            "expr": "sum(increase(dms_invocation_duration_seconds_count{job=\"machinespirit-app\", function=\"RefillBacklog\", outcome=\"failed\"}[1h])) or vector(0)"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": { "refId": "C", "type": "threshold", "expression": "A", "conditions": [{ "evaluator": { "type": "gt", "params": [2] } }] }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "summary": "A backlog refill failed all three tries in the last hour.",
        "description": "RefillBacklog tries a message three times, ten minutes apart, so a passing failure doesn't alert. Look at its error logs in Grafana (Loki, service machinespirit-app): a model, Jev or Cosmos DB. The backlog shrinks by one a day until refills work again; Summon New Rites in the Scriptorium tries again."
      }
    },
    {
      "uid": "dms-backlog-empty",
      "title": "Backlog ran empty",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 604800, "to": 0 },
          "datasourceUid": "${prometheus}",
          "model": {
            "refId": "A",
            "instant": true,
            "expr": "sum(increase(dms_backlog_empty_total{job=\"machinespirit-app\"}[7d])) or vector(0)"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": { "refId": "C", "type": "threshold", "expression": "A", "conditions": [{ "evaluator": { "type": "gt", "params": [1] } }] }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "summary": "Publishing found the backlog empty more than once this week.",
        "description": "Each time, the day's rite was written on the spot, unmoderated. Refills aren't keeping up: check the Refills failing alert, and summon new rites in the Scriptorium."
      }
    },
    {
      "uid": "dms-jev-failing",
      "title": "Jev failing",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 10800, "to": 0 },
          "datasourceUid": "${prometheus}",
          "model": {
            "refId": "A",
            "instant": true,
            "expr": "sum(increase(dms_judging_runs_total{job=\"machinespirit-app\", outcome=\"failed\"}[3h])) / sum(increase(dms_judging_runs_total{job=\"machinespirit-app\", outcome=~\"judged|failed\"}[3h]))"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": { "refId": "C", "type": "threshold", "expression": "A", "conditions": [{ "evaluator": { "type": "gt", "params": [0.5] } }] }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "summary": "Most drafts in the last three hours couldn't be judged.",
        "description": "Drafts still join the backlog, but without a quality or scores, so the Augury puts them last and More rites falls back to the newest. Look at the warnings in Grafana (Loki, service machinespirit-app): an expired Jev key, or Jev down."
      }
    },
    {
      "uid": "dms-errors",
      "title": "Server errors",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "${prometheus}",
          "model": {
            "refId": "A",
            "instant": true,
            "expr": "(sum(increase(dms_invocation_duration_seconds_count{job=\"machinespirit-app\", function!~\"DailyRite|RefillBacklog\", outcome=~\"5..|failed\"}[10m])) / sum(increase(dms_invocation_duration_seconds_count{job=\"machinespirit-app\", function!~\"DailyRite|RefillBacklog\"}[10m]))) and on() (sum(increase(dms_invocation_duration_seconds_count{job=\"machinespirit-app\", function!~\"DailyRite|RefillBacklog\"}[10m])) >= 10)"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": { "refId": "C", "type": "threshold", "expression": "A", "conditions": [{ "evaluator": { "type": "gt", "params": [0.05] } }] }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "annotations": {
        "summary": "More than 5% of production's requests failed (5xx) for ten minutes.",
        "description": "Only counted over at least ten requests in ten minutes, so one failure on a quiet night doesn't alert. The dashboard's Traffic row shows which function; its error logs say why (often Cosmos DB)."
      }
    },
    {
      "uid": "dms-no-telemetry",
      "title": "No telemetry from production",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 93600, "to": 0 },
          "datasourceUid": "${prometheus}",
          "model": {
            "refId": "A",
            "instant": true,
            "expr": "count(last_over_time(target_info{job=\"machinespirit-app\"}[26h]))"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": { "refId": "C", "type": "threshold", "expression": "A", "conditions": [{ "evaluator": { "type": "lt", "params": [1] } }] }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "summary": "Production has sent no telemetry for 26 hours.",
        "description": "The app sleeps when nobody visits, but the DailyRite timer wakes it every midnight, so a day of silence means the export is broken (the OtlpHeaders token, revoked or read-only) or the app is down. Every other alert is blind until this is fixed."
      }
    }
  ]
}
