root = true

# The repository's C# style. The build enforces every rule marked warning (EnforceCodeStyleInBuild, and warnings are
# errors); CI's `dotnet format style --verify-no-changes` catches those the build doesn't report. The rest of the style
# is in CLAUDE.md, "Code style rules".
[*.cs]
indent_style = space
indent_size = 4

# Braces always, even around a one-line body.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# File-scoped namespaces, usings outside them, System first.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true

# `this.` only where a parameter has the field's name (constructors).
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0009.severity = warning

# Unused usings and unreachable private members go.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Private fields camelCase, no underscore; constants and static readonly fields PascalCase.
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_are_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case.style = camel_case
dotnet_naming_rule.private_fields_are_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_diagnostic.IDE1006.severity = warning

# The recommended analyzers (AnalysisLevel in Directory.Build.props) are on, but for these, which don't fit the code.
# The XML documentation file is built only so the build can report unused usings (IDE0005): a summary is written where
# it says something, never for every member.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS1573.severity = none
# Logging through ILogger's extension methods is the house style: no LoggerMessage delegates.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# What it flags formats integers; dates and counts, which do differ by culture, name theirs (Html.Count, Date).
dotnet_diagnostic.CA1305.severity = none
# Names clashing with Visual Basic's keywords (Get, Erase) or type names (Short): there's no Visual Basic here.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
# The functions' methods, which the Functions host calls on an instance, stay instance methods like their neighbours.
dotnet_diagnostic.CA1822.severity = none
# Parameters and results are the read-only interfaces, not the concrete collection behind them.
dotnet_diagnostic.CA1859.severity = none

[tests/**.cs]
# Test names read as sentences: Subject_Scenario_Outcome.
dotnet_diagnostic.CA1707.severity = none
# Arrays written into an assertion read as the expected values; a test runs once.
dotnet_diagnostic.CA1861.severity = none
# xUnit makes a test class for each test, and a fixture's clients live as long as the test run.
dotnet_diagnostic.CA1001.severity = none
# An xUnit collection definition is named after the collection.
dotnet_diagnostic.CA1711.severity = none
