<Project>

  <!-- For every project: no nulls slip through. A nullable warning is a build error, and maybe-absent values are
       LanguageExt's Option<T> (CLAUDE.md, "Code style rules"). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Every warning fails the build, so none piles up unread. A NuGet security advisory is a warning too (NU1901-NU1904),
       for a package referenced directly or one that only comes in through another: it blocks the build until a fixed
       version is taken. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- The code-style rules .editorconfig marks as errors fail the build, not just the editor. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
