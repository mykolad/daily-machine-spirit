<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks a deployed app over HTTP, as a reader would; it never references the app's code. The deployments publish it
       into the app's package and run it there (CLAUDE.md, "Deploying"). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
