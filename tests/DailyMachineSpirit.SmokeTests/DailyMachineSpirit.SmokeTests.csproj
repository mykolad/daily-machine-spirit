<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks a deployed app over HTTP, as a reader would; it never references the app's code. The deployments publish it
       into the app's package and run it there (CLAUDE.md, "Deploying"). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Run through VSTest (xunit.runner.visualstudio), as dotnet test, the coverage collector and the deployments'
         smoke tests expect, rather than xUnit's default Microsoft.Testing.Platform runner. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
